#!/usr/bin/env bash
# Build the full site and the Coming Soon site, then check that they stay
# independent: source is unchanged, asset paths resolve, and production
# deep links do not serve lesson, lab, cheat sheet, or note content.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

snapshot() {
  find . -type f \
    ! -path './_site/*' \
    ! -path './_site-coming-soon/*' \
    ! -path './.jekyll-cache/*' \
    ! -path './.jekyll-metadata' \
    ! -path './.sass-cache/*' \
    ! -path './vendor/*' \
    ! -path './.bundle/*' \
    ! -path './.git/*' \
    -print0 | sort -z | xargs -0 sha256sum
}

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

echo "== guard: destination override is rejected =="
set +e
./script/build-coming-soon _site
override_status=$?
set -e
[[ "$override_status" -eq 2 ]] || fail "expected exit 2 when a destination argument is passed, got $override_status"

echo "== guard: symlinked output is rejected and its target is kept =="
canary_dir="$(mktemp -d)"
canary_file="$canary_dir/keep-me"
echo kept > "$canary_file"
rm -rf -- "$ROOT/_site-coming-soon"
ln -s "$canary_dir" "$ROOT/_site-coming-soon"
set +e
./script/build-coming-soon
symlink_status=$?
set -e
[[ "$symlink_status" -eq 1 ]] || fail "expected exit 1 for a symlinked output, got $symlink_status"
[[ "$(cat "$canary_file")" == "kept" ]] || fail "symlink target was modified"
rm -- "$ROOT/_site-coming-soon"
rm -rf -- "$canary_dir"

echo "== snapshot source before builds =="
before="$(snapshot)"

rm -rf -- "$ROOT/_site" "$ROOT/_site-coming-soon"

echo "== build coming soon (before the full site exists) =="
./script/build-coming-soon
after_coming="$(snapshot)"
[[ "$before" == "$after_coming" ]] || fail "coming-soon build changed source files"

echo "== build full site with the default Jekyll command =="
bundle exec jekyll build
after_jekyll="$(snapshot)"

lesson_hash="$(sha256sum "$ROOT/_site/lessons/linux/filesystem/index.html")"
coming_hash="$(sha256sum "$ROOT/_site-coming-soon/index.html")"

echo "== rebuild coming soon and confirm it does not touch the full site =="
./script/build-coming-soon
[[ "$(sha256sum "$ROOT/_site/lessons/linux/filesystem/index.html")" == "$lesson_hash" ]] || fail "coming-soon rebuild changed the full-site lesson output"
[[ "$(snapshot)" == "$after_jekyll" ]] || fail "coming-soon rebuild changed source files after Jekyll"
[[ -f "$ROOT/_site-coming-soon/index.html" && -f "$ROOT/_site-coming-soon/404.html" ]] || fail "coming-soon output is incomplete"

echo "== full site still contains the learning site =="
full_required=(
  index.html
  404.html
  lessons/index.html
  lessons/linux/index.html
  lessons/linux/filesystem/index.html
  lessons/linux/shell-prompt/index.html
  labs/index.html
  labs/linux/index.html
  labs/linux/filesystem/index.html
  labs/linux/shell-prompt/index.html
  cheatsheets/index.html
  cheatsheets/linux/index.html
  cheatsheets/linux/files-and-directories/index.html
  cheatsheets/linux/getting-around/index.html
  assets/css/site.css
  assets/img/logo-white-gold.png
  assets/img/logo-all-gold.png
  assets/img/logo-white-gold-header.png
  assets/img/linux-directory-tree.png
  assets/js/site.js
  search.json
)
for rel in "${full_required[@]}"; do
  [[ -f "$ROOT/_site/$rel" ]] || fail "full site missing $rel"
done
[[ ! -e "$ROOT/_site/coming-soon" ]] || fail "default build published the coming-soon source"
[[ ! -e "$ROOT/_site/script" ]] || fail "default build published the build scripts"
[[ ! -e "$ROOT/_site/notes/index.html" ]] || fail "default build published the unpublished notes index"
grep -q 'href="/lessons/"' "$ROOT/_site/index.html" || fail "full splash is missing the lessons link"
grep -q 'href="/labs/"' "$ROOT/_site/index.html" || fail "full splash is missing the labs link"
grep -q 'href="/cheatsheets/"' "$ROOT/_site/index.html" || fail "full splash is missing the cheat sheets link"
grep -q 'The examples use the account' "$ROOT/_site/lessons/linux/filesystem/index.html" || fail "filesystem lesson text missing from the full site"

echo "== coming soon output is only the branded page and splash assets =="
coming_required=(
  index.html
  404.html
  assets/css/site.css
  assets/favicon-32.png
  assets/favicon-192.png
  assets/apple-touch-icon.png
  assets/img/logo-all-gold.png
  assets/img/logo-all-gold.webp
  assets/img/logo-all-gold-2x.webp
  assets/img/logo-white-gold.png
  assets/img/logo-white-gold.webp
  assets/img/logo-white-gold-2x.webp
)
for rel in "${coming_required[@]}"; do
  [[ -f "$ROOT/_site-coming-soon/$rel" ]] || fail "coming soon missing $rel"
done
coming_absent=(
  lessons
  labs
  cheatsheets
  notes
  search.json
  sitemap.xml
  assets/js/site.js
  assets/img/linux-directory-tree.png
  assets/img/logo-black-header.png
)
for rel in "${coming_absent[@]}"; do
  [[ ! -e "$ROOT/_site-coming-soon/$rel" ]] || fail "coming soon leaked $rel"
done
cmp -s "$ROOT/_site-coming-soon/index.html" "$ROOT/_site-coming-soon/404.html" || fail "404.html is not the coming soon page"
grep -q '#0B0B0C' "$ROOT/_site-coming-soon/assets/css/site.css" || fail "coming soon CSS missing the dark background"
grep -q '#E3BF6A' "$ROOT/_site-coming-soon/assets/css/site.css" || fail "coming soon CSS missing gold"
grep -q 'var(--grid-line)' "$ROOT/_site-coming-soon/assets/css/site.css" || fail "coming soon CSS missing the dark grid"

echo "== serve both outputs and check routes =="
python3 - "$ROOT" <<'PY'
import hashlib
import json
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import unquote, urlparse
from urllib.request import urlopen

root = Path(sys.argv[1]).resolve()

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        site = Path(self.server.site_root).resolve()
        rel = unquote(urlparse(self.path).path).lstrip("/")
        candidate = (site / rel).resolve()
        if site != candidate and site not in candidate.parents:
            self.send_error(403)
            return
        if candidate.is_dir():
            candidate = candidate / "index.html"
        if candidate.is_file():
            data = candidate.read_bytes()
            self.send_response(200)
            self.send_header("Content-Type", self.guess(candidate))
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
            return
        page = site / "404.html"
        data = page.read_bytes() if page.is_file() else b"missing"
        self.send_response(404)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def guess(self, path):
        suffix = path.suffix.lower()
        return {
            ".html": "text/html; charset=utf-8",
            ".css": "text/css; charset=utf-8",
            ".js": "text/javascript; charset=utf-8",
            ".json": "application/json",
            ".png": "image/png",
            ".webp": "image/webp",
        }.get(suffix, "application/octet-stream")

    def log_message(self, fmt, *args):
        return

def serve(directory):
    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    server.site_root = str(directory)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    return server

def fetch(base, path):
    try:
        with urlopen(base + path) as response:
            return response.status, response.read()
    except HTTPError as error:
        return error.code, error.read()

def expect(base, path, status, contains=None, forbids=None):
    code, body = fetch(base, path)
    if code != status:
        raise SystemExit(f"{path} on {base} returned {code}, expected {status}")
    text = body.decode("utf-8", "replace")
    for needle in contains or []:
        if needle not in text:
            raise SystemExit(f"{path} on {base} is missing {needle!r}")
    for needle in forbids or []:
        if needle in text:
            raise SystemExit(f"{path} on {base} leaked {needle!r}")
    return body

full = serve(root / "_site")
soon = serve(root / "_site-coming-soon")
full_base = f"http://127.0.0.1:{full.server_address[1]}"
soon_base = f"http://127.0.0.1:{soon.server_address[1]}"

learning_links = (
    'href="/lessons/',
    'href="/labs/',
    'href="/cheatsheets/',
    'href="/notes/',
    'href="/search',
)
lesson_marker = "The examples use the account"
deep_paths = (
    "/lessons/",
    "/lessons/linux/",
    "/lessons/linux/filesystem/",
    "/lessons/linux/filesystem",
    "/lessons/linux/shell-prompt/",
    "/labs/",
    "/labs/linux/shell-prompt/",
    "/cheatsheets/",
    "/cheatsheets/linux/getting-around/",
    "/cheatsheets/git/",
    "/notes/",
    "/notes/change-checklist/",
    "/search.json",
    "/search/",
    "/assets/img/linux-directory-tree.png",
    "/assets/js/site.js",
    "/this-page-is-not-real",
)

expect(full_base, "/", 200, contains=['href="/lessons/"', 'href="/labs/"', 'href="/cheatsheets/"'])
expect(full_base, "/lessons/linux/filesystem/", 200, contains=[lesson_marker, "/assets/css/site.css"])
expect(full_base, "/labs/linux/shell-prompt/", 200, contains=["shell-prompt", "/assets/css/site.css"])
expect(full_base, "/cheatsheets/linux/getting-around/", 200, contains=["getting-around"])
expect(full_base, "/assets/css/site.css", 200, contains=["#0B0B0C", "#E3BF6A", "var(--grid-line)"])
expect(full_base, "/search.json", 200, contains=["filesystem"])
png = expect(full_base, "/assets/img/logo-white-gold.png", 200)
if png[:8] != b"\x89PNG\r\n\x1a\n":
    raise SystemExit("full site logo is not a PNG")
expect(full_base, "/this-page-is-not-real", 404, contains=["That page is not here.", 'href="/lessons/"'])

expect(soon_base, "/", 200, contains=["Coming soon", "/assets/css/site.css", "/assets/img/logo-white-gold.png"], forbids=learning_links)
expect(soon_base, "/index.html", 200, contains=["Coming soon"], forbids=learning_links)
expect(soon_base, "/assets/css/site.css", 200, contains=["#0B0B0C", "#E3BF6A", "var(--grid-line)"])
soon_png = expect(soon_base, "/assets/img/logo-white-gold.png", 200)
soon_gold = expect(soon_base, "/assets/img/logo-all-gold.png", 200)
if soon_png[:8] != b"\x89PNG\r\n\x1a\n" or soon_gold[:8] != b"\x89PNG\r\n\x1a\n":
    raise SystemExit("coming soon logo is not a PNG")
expect(soon_base, "/assets/favicon-32.png", 200)
for path in deep_paths:
    expect(
        soon_base,
        path,
        404,
        contains=["Coming soon"],
        forbids=learning_links + (lesson_marker, "linux-directory-tree", "github.com"),
    )

report = {
    "full_site": full_base,
    "coming_soon": soon_base,
    "full_logo_sha256": hashlib.sha256(png).hexdigest(),
    "coming_soon_logo_sha256": hashlib.sha256(soon_png).hexdigest(),
    "deep_paths_checked": list(deep_paths),
}
if report["full_logo_sha256"] != report["coming_soon_logo_sha256"]:
    raise SystemExit("coming soon logo bytes differ from the full site logo")
print(json.dumps(report, indent=2))
full.shutdown()
soon.shutdown()
PY

echo "OK: full site and coming soon outputs passed"
